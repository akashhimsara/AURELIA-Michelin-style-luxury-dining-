// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Restaurant {
  id           String        @id @default(uuid())
  name         String
  address      String
  phone        String
  email        String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  
  // Relations
  reservations Reservation[]
  menuItems    Menu[]
  galleryItems Gallery[]
  events       Event[]
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String
  phone        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  reservations Reservation[]
}

model Admin {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  role         String        @default("manager") // manager, superadmin
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Reservation {
  id           String      @id @default(uuid())
  restaurantId String
  userId       String?
  name         String      // Fallback or user input
  email        String
  phone        String
  date         DateTime
  time         String
  guests       Int
  status       String      @default("pending") // pending, confirmed, cancelled
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relations
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Indexes
  @@index([restaurantId])
  @@index([userId])
  @@index([date])
}

model Menu {
  id           String     @id @default(uuid())
  restaurantId String
  name         String
  description  String
  price        Decimal    @db.Decimal(10, 2)
  category     String     // Appetizer, Main Course, Dessert, Cocktail
  image        String
  tags         String[]   // String array (supported in PostgreSQL)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([restaurantId])
  @@index([category])
}

model Gallery {
  id           String     @id @default(uuid())
  restaurantId String
  imageUrl     String
  caption      String
  category     String     // Interior, Culinary, Events
  createdAt    DateTime   @default(now())

  // Relations
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([restaurantId])
}

model Event {
  id           String     @id @default(uuid())
  restaurantId String
  title        String
  description  String
  date         DateTime
  price        Decimal    @db.Decimal(10, 2)
  capacity     Int
  imageUrl     String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([restaurantId])
  @@index([date])
}

model Message {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("unread") // unread, read, archived
  createdAt DateTime @default(now())
}
