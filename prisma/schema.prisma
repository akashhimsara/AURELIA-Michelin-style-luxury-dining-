// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id        String   @id @default(uuid())
  name      String   @unique // e.g., guest, concierge, admin
  createdAt DateTime @default(now())
  users     User[]
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String
  phone        String?
  roleId       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Auth fields
  passwordHash         String?
  emailVerified        DateTime?
  verificationToken    String?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  socialProvider       String?
  socialId             String?

  // Relations
  role         Role?         @relation(fields: [roleId], references: [id], onDelete: SetNull)
  reservations Reservation[]
  profile      GuestProfile?

  @@index([roleId])
}

model Admin {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  role         String        @default("manager") // manager, superadmin
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Restaurant {
  id           String        @id @default(uuid())
  name         String
  address      String
  phone        String
  email        String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  
  // Relations
  reservations Reservation[]
  menuItems    Menu[]
  galleryItems Gallery[]
  events       Event[]
}

model Room {
  id            String        @id @default(uuid())
  name          String        @unique // e.g., Ocean Presidential Suite
  description   String
  pricePerNight Decimal       @db.Decimal(10, 2)
  capacity      Int
  imageUrl      String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  reservations  Reservation[]
  facilities    Facility[]
}

model Facility {
  id          String   @id @default(uuid())
  name        String   @unique // e.g., Private Infinity Pool, Butler Service
  description String
  imageUrl    String?
  createdAt   DateTime @default(now())
  rooms       Room[]
}

model Reservation {
  id                  String      @id @default(uuid())
  restaurantId        String?
  roomId              String?
  userId              String?
  name                String      // Guest name fallback
  email               String
  phone               String
  date                DateTime
  checkOutDate        DateTime?
  time                String?     // Optional (seating slots use time, rooms use dates)
  guests              Int
  children            Int         @default(0)
  status              String      @default("pending") // pending, confirmed, cancelled
  specialRequests     String?
  dietaryRequirements String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  // Historical Billing Snapshots
  roomRateAtBooking   Decimal?    @db.Decimal(10, 2)
  bookedRoomName      String?
  finalAmount         Decimal?    @db.Decimal(10, 2)

  // Relations
  restaurant          Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  room                Room?       @relation(fields: [roomId], references: [id], onDelete: SetNull)
  user                User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Indexes
  @@index([restaurantId])
  @@index([roomId])
  @@index([userId])
  @@index([date])
}

model Menu {
  id           String     @id @default(uuid())
  restaurantId String
  name         String
  description  String
  price        Decimal    @db.Decimal(10, 2)
  category     String     // Appetizer, Main Course, Dessert, Cocktail
  image        String
  tags         String[]   // String array (supported in PostgreSQL)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([restaurantId])
  @@index([category])
}

model Gallery {
  id           String     @id @default(uuid())
  restaurantId String
  imageUrl     String
  caption      String
  category     String     // Interior, Culinary, Events
  createdAt    DateTime   @default(now())

  // Relations
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([restaurantId])
}

model Event {
  id           String     @id @default(uuid())
  restaurantId String
  title        String
  description  String
  date         DateTime
  price        Decimal    @db.Decimal(10, 2)
  capacity     Int
  imageUrl     String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([restaurantId])
  @@index([date])
}

model Offer {
  id            String    @id @default(uuid())
  code          String    @unique // e.g., ESCAPE20
  title         String
  description   String
  discountType  String    // percentage, fixed
  discountValue Decimal   @db.Decimal(10, 2)
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
}

model Testimonial {
  id        String   @id @default(uuid())
  name      String
  avatarUrl String?
  quote     String
  rating    Int      @default(5)
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("unread") // unread, read, archived
  createdAt DateTime @default(now())
}

model Newsletter {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Blog {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  content     String
  category    String   // Culinary, Wellness, Heritage
  imageUrl    String
  authorName  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Spa {
  id          String   @id @default(uuid())
  name        String   @unique
  duration    String   // e.g. "90 Mins"
  price       Decimal  @db.Decimal(10, 2)
  description String
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GuestProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  avatarUrl        String?
  nationality      String?
  emergencyContact String?
  pillowType       String?
  dietaryNotes     String?
  vipTier          String   @default("Standard Guest")
  loyaltyPoints    Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
